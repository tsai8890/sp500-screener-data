# Copy this file to .env (same folder) and fill in your own key.
# .env is ignored by git, so the key never leaves this computer.

# Finnhub (free account at https://finnhub.io): fast quotes, every 15 s, for the
# stock open in Advanced Analysis and the first 10 of your current watchlist.
FINNHUB_API_KEY=

# SEC EDGAR (free, official): financial statements straight from 10-Q / 10-K filings,
# minutes after a company files (Yahoo takes days). The SEC asks every program to say
# who is calling: your name and an email address. Leave empty to use Yahoo only.
SEC_USER_AGENT=
